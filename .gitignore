# ---- Compiled paper output (rebuild via pdflatex; see README) ----
paper/*.pdf
posters/*.pdf

# Figure PDFs ARE tracked (shipping artifacts of the paper). Rasters and intermediate
# SVGs in figures/ are regenerated on demand and stay out; the web-sized previews the
# README shows live in docs/img/ and are tracked.
figures/*.html
figures/*.svg
figures/*.png

# Cached intermediates, rebuilt by the figure scripts on demand. The slow scans
# (basin map, orbit zoo) write these so a rerun does not repeat the computation.
code/.cache*.npz
code/_*.json

