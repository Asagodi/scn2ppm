@Inbook{bich2016outonomy,
author="Bich, Leonardo
and Bechtel, William",
editor="Barandiaran, Xabier E.
and Etxeberria, Arantza",
title="Autonomy and Heterarchy: Organizing Control in Biological Organisms",
bookTitle="Outonomy: Fleshing out the Concept of Autonomy Beyond the Individual",
year="2026",
publisher="Springer Nature Switzerland",
address="Cham",
pages="23--32",
abstract="In order to maintain themselves as systems far from equilibrium with their environment, organisms must control the operation of numerous production mechanisms. Control involves mechanisms that make or are responsive to measurements of conditions within or in the environment of the organism and that operate on flexible constraints in other mechanisms to adjust their operation. A frequent assumption of humans is that control mechanisms are organized in a hierarchical pyramid. However, control in biological organisms commonly deviates from several principles of hierarchical organization and is better characterized as organized heterarchically. To provide a positive understanding of autonomy, this paper advances several features of its heterarchical organization and illustrates them using control of glucose regulation in mammals as an exemplar.",
isbn="978-3-032-05501-9",
doi="10.1007/978-3-032-05501-9_3",
url="https://doi.org/10.1007/978-3-032-05501-9_3"
}

